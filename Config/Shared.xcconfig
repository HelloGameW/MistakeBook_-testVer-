IPHONEOS_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SDKROOT = iphoneos
// Xcode 26 expands the simulator ARCHS_STANDARD with x86_64, but SwiftPM
// package products only build the arm64 simulator slice, so the app's
// x86_64 slice cannot resolve the package modules during test builds.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64
CLANG_ENABLE_MODULES = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
CODE_SIGN_STYLE = Automatic
MARKETING_VERSION = 0.5.2
CURRENT_PROJECT_VERSION = 22
